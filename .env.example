# Copy to .env and fill in. Never commit .env.

# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Used when running the API outside Docker (docker-compose sets its own).
DATABASE_URL=postgresql+psycopg://papeles:papeles@localhost:5432/papeles

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
