# Copy to .env and fill in. Never commit .env.

# Which AI writes the answers: claude, groq, gemini or openrouter.
# groq, gemini and openrouter have free tiers that need no credit card.
#   groq:       https://console.groq.com/keys
#   gemini:     https://aistudio.google.com/apikey
#   openrouter: https://openrouter.ai/keys
#   claude:     https://console.anthropic.com (paid)
LLM_PROVIDER=groq
LLM_API_KEY=

# Search embeddings. Gemini is free (no card) and keeps the API small enough for free hosts.
#   https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

# Optional: override the provider's default model or endpoint.
# LLM_MODEL=
# LLM_BASE_URL=

# Used when running the API outside Docker (docker-compose sets its own).
# Postgres:            postgresql+psycopg://papeles:papeles@localhost:5432/papeles
# SQLite (no Docker):  sqlite:///apps/api/papeles.db
DATABASE_URL=postgresql+psycopg://papeles:papeles@localhost:5432/papeles
